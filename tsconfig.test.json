{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"rootDir": ".",
		"outDir": ".test-out",
		"types": [
			"node",
			"mocha"
		],
		"sourceMap": false,
		"declaration": true,
		"declarationMap": false,
		"declarationDir": ".test-out/types"
	},
	"include": [
		"src/**/*.ts",
		"tests/**/*.ts"
	],
	"exclude": [
		"node_modules",
		".test-out",
		"dist"
	]
}
