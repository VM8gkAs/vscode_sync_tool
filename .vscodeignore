# ── OS junk ──
.DS_Store
Thumbs.db

# ── IDE / editor ──
.idea/**
.vscode/**
.vscode-test/**

# ── Source / build tooling (not shipped) ──
src/**
tests/**
scripts/**
.github/**
.nvmrc
AGENTS.md
build/**
lib/**
types/**
node_modules/**
